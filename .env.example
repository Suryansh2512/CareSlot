# Copy to .env.local; never commit real values.
GEMINI_API_KEY=
# Explicitly set the trainer-approved model available to your API key.
# The official guide names gemini-3.8-flash; verify with your trainer/account.
GEMINI_MODEL=
SUPABASE_URL=
# Server-only secret/service_role key from the SAME Supabase project.
SUPABASE_SECRET_KEY=
# Choose a long random team passcode. Also signs exact-action confirmations.
APP_PASSCODE=
